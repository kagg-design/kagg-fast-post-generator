{
  "name": "kagg/generator",
  "description": "KAGG Fast Post Generator",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "generate posts",
    "generate pages",
    "development",
    "bulk generate"
  ],
  "homepage": "https://wordpress.org/plugins/kagg-fast-post-generator/",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "KAGG Design",
      "email": "info@kagg.eu",
      "homepage": "https://kagg.eu/en/"
    }
  ],
  "support": {
    "issues": "https://wordpress.org/support/plugin/kagg-kagg-fast-post-generator"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "kylekatarnls/update-helper": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-pdo": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13.6",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "KAGG\\Generator\\": "src/php"
    }
  },
  "scripts": {
    "changelog": "@php .github/scripts/update-changelog.php",
    "changelog:check": "@php .github/scripts/update-changelog.php --check",
    "test:changelog": "@php tests/changelog.php",
    "phpcs": "vendor/bin/phpcs --colors --standard=phpcs.xml"
  }
}
